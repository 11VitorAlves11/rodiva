# ---- Base de dados ----
POSTGRES_USER=rodiva
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rodiva
DATABASE_URL=postgresql+asyncpg://rodiva:change-me@db:5432/rodiva

# ---- Autenticação ----
# "local" para contas locais; "oidc" acrescenta o fornecedor de identidade sem
# desligar a entrada local — um fornecedor em baixo não pode trancar o agregado.
AUTH_MODE=local
# Assina o cookie de sessão. Obrigatório com ENVIRONMENT=prod; trocá-lo termina
# todas as sessões. Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Se falso, o registo público fica desativado (RF-AUT-005) e as contas só podem
# ser criadas por convite.
ALLOW_PUBLIC_REGISTRATION=true

# ---- Aplicação ----
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:5173"]
# Nomes de anfitrião aceites no cabeçalho Host. Uma instalação acessível fora da
# rede local deve indicar o seu, para que um Host forjado não entre nas ligações
# que a aplicação constrói. Exemplo: ALLOWED_HOSTS=["rodiva.exemplo.pt"]
ALLOWED_HOSTS=["*"]
DEFAULT_LOCALE=pt-PT
DEFAULT_CURRENCY=EUR
DEFAULT_DISTANCE_UNIT=km
DEFAULT_TIMEZONE=Europe/Lisbon

# ---- Anexos ----
STORAGE_PATH=/storage
UPLOAD_MAX_BYTES=20971520

# ---- Recuperação de palavra-passe por email ----
# Sem SMTP configurado, a recuperação fica indisponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PUBLIC_FRONTEND_URL=http://localhost:5173

# ---- OpenID Connect (RF-AUT-006) ----
# Vazio desativa. O endereço de retorno a registar no fornecedor é
# <PUBLIC_BASE_URL>/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# ---- Notificações no dispositivo (Web Push) ----
# Gerar o par com:
#   python -c "from app.services.web_push import generate_vapid_keys as g; print(g())"
# A metade privada nunca entra no repositório.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
